# Chaupal Network & Deployment Environment Configuration
# Provide real values in your local .env file (DO NOT COMMIT .env)

# JSON-RPC Provider URL (Polygon PoS / Amoy / Local Hardhat)
RPC_URL=https://polygon-rpc.com

# Deployer Private Key (Hex string without 0x prefix or with 0x)
DEPLOYER_PRIVATE_KEY=

# Deployed ChaupalMembership Smart Contract Address
NEXT_PUBLIC_CONTRACT_ADDRESS=0x71C8349219b258E2958045F207D67BaAc68C49b2

# Chain ID (137 for Polygon Mainnet, 80002 for Polygon Amoy, 31337 for Local Foundry)
NEXT_PUBLIC_CHAIN_ID=137

# Etherscan / Polygonscan API Key for contract verification
POLYGONSCAN_API_KEY=
